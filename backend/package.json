{
  "name": "glucotrack-backend-proxy-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:install": "node install-db.js",
    "db:backup": "node scripts/backup-database.mjs",
    "admin:create": "node create-admin.js",
    "start": "node server.js",
    "start:test": "node --env-file=.env.test server.js",
    "test": "node --test",
    "migrate:test": "node --env-file=.env.test scripts/migrate-test.mjs",
    "db:test:check": "node --env-file=.env.test scripts/db-test-check.js",
    "db:test:schema-check": "node --env-file=.env.test scripts/db-test-schema-check.js"
    ,"seed:test": "node --env-file=.env.test scripts/seed-test.js"
    ,"test:family:integration": "NODE_ENV=test node --test --test-concurrency=1 test/integration/family/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "google-auth-library": "^10.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.56.0",
    "stripe": "^18.5.0"
  }
}
