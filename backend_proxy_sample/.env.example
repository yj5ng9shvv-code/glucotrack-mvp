PORT=8787
NODE_ENV=production

# MySQL/MariaDB database from Hestia/phpMyAdmin.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=diabetik_app
DB_USER=admin_glukotrack
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10
DB_AUTO_CREATE=true

# Optional. Use only when DB_USER cannot create a database and the database
# has not already been created in Hestia. Leave empty in the normal case.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Generate a random value of at least 32 characters.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed to call the API from browser clients.
ALLOWED_ORIGINS=https://glukotrack.com,https://www.glukotrack.com
PUBLIC_BASE_URL=https://api.glukotrack.com
RATE_LIMIT_PER_MINUTE=60
MAX_IMAGE_MB=8

# Optional webhook for email, Telegram, SMS, or push automation.
# Receives patient QR scan events and permitted geolocation.
SOS_SCAN_WEBHOOK_URL=

# Required for AI endpoints.
OPENAI_API_KEY=change_me_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Required for subscription/payment endpoints.
STRIPE_SECRET_KEY=change_me_stripe_secret_key
STRIPE_WEBHOOK_SECRET=change_me_stripe_webhook_secret
STRIPE_MONTHLY_PRICE_ID=price_change_me_monthly
STRIPE_YEARLY_PRICE_ID=price_change_me_yearly
STRIPE_SUCCESS_URL=https://glukotrack.com/app/#/subscription/success
STRIPE_CANCEL_URL=https://glukotrack.com/app/#/subscription/cancel
STRIPE_PORTAL_RETURN_URL=https://glukotrack.com/app/#/subscription
